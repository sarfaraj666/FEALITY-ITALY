# ==============================================================================
# FEALITY ITALY - Environment Template (.env.example)
# ==============================================================================
# Copy this file to '.env' and fill in your actual environment credentials:
#   cp .env.example .env
# DO NOT commit your actual '.env' file to source control.
# ==============================================================================

# Application Environment & Port
PORT=3000
NODE_ENV=production

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=feality_italy

# Admin Portal Authentication (Set a strong, unique password for /admin.html)
ADMIN_PASSWORD=your_secure_admin_password_here

# External Integrations (Optional: Google Apps Script Webhook URL)
GOOGLE_SCRIPT_URL=

# Business Contact Settings
CONTACT_EMAIL=info@fealityitaly.com
WHATSAPP_NUMBER=919832722644
PHONE_NUMBER=+919522251777
